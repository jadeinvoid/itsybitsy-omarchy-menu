{
  "schemaVersion": 1,
  "id": "itsybitsy.menu",
  "name": "Itsybitsy Menu",
  "version": "1.0.1",
  "author": "Jade Yejin Cho",
  "description": "Omarchy command menu with randomized theme colors",
  "kinds": [
    "menu",
    "bar-widget"
  ],
  "keepLoaded": true,
